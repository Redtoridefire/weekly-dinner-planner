{
  "name": "the-dinner-table",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build && npm run preview",
    "dev": "npm run build && npm run preview",
    "build": "node build.mjs",
    "preview": "python3 -m http.server 4173 --bind 0.0.0.0 --directory dist",
    "test": "node --test app.test.js tests/*.test.js",
    "test:browser": "playwright test",
    "check": "npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
